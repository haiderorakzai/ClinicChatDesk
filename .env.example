# App
NODE_ENV=development
PORT=3100
APP_NAME=ClinicChatDesk
PUBLIC_URL=http://localhost:3100
DATA_DIR=
SESSION_COOKIE_NAME=clinicchatdesk_session
SESSION_DAYS=7
MESSAGE_RETENTION_DAYS=30

# Required secrets - generate with: npm run secrets
SESSION_SECRET=replace_me
APP_ENCRYPTION_KEY=replace_me

# First super-admin account (created on first startup only)
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_password

# OpenAI - server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
DEMO_MODE=true

# Meta / WhatsApp
META_GRAPH_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=replace_with_random_verify_token
META_APP_SECRET=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional: only set this if your Meta OAuth configuration specifically requires
# the exact redirect URI during code exchange. Leave blank for normal FB.login Embedded Signup.
META_OAUTH_REDIRECT_URI=
# Meta Embedded Signup helper settings. These match the v4/session-info v3 flow.
META_EMBEDDED_SIGNUP_ES_VERSION=v4
META_EMBEDDED_SIGNUP_SESSION_INFO_VERSION=3
# Leave blank unless your Meta Login Configuration requires a feature type
# (for example a custom/coexistence flow configured in Meta).
META_EMBEDDED_SIGNUP_FEATURE_TYPE=


# Meta App Review developer connection (v2.6.10)
# This is ONLY for the clinic account you use while recording Meta App Review.
# Keep META_REVIEW_MODE=false in normal production after review.
# Never put META_REVIEW_ACCESS_TOKEN in browser/client code.
META_REVIEW_MODE=false
META_REVIEW_ALLOWED_EMAIL=
META_REVIEW_WABA_ID=
META_REVIEW_PHONE_NUMBER_ID=
META_REVIEW_DISPLAY_NUMBER=
META_REVIEW_ACCESS_TOKEN=

# Optional commercial settings
TRIAL_DAYS=14
STARTER_PRICE_USD=99
PRO_PRICE_USD=249
GROWTH_PRICE_USD=499

# Voice-note transcription
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Revenue Recovery WhatsApp templates
# Free-form messages can be sent within WhatsApp's active customer-service window.
# For business-initiated messages outside that window, configure approved Meta templates.
WHATSAPP_RECOVERY_TEMPLATE_NAME=
WHATSAPP_RECOVERY_TEMPLATE_LANG=en_US
WHATSAPP_RECOVERY_TEMPLATE_PREVIEW=We sent a follow-up to help you finish booking.
WHATSAPP_CANCELLATION_TEMPLATE_NAME=
WHATSAPP_CANCELLATION_TEMPLATE_LANG=en_US
WHATSAPP_CANCELLATION_TEMPLATE_PREVIEW=An earlier appointment slot is available. Reply if you want it.
CANCELLATION_OFFER_EXPIRY_MINUTES=20

# Public self-service demo safeguards (v2.4)
DEMO_AI_REQUEST_LIMIT=15
DEMO_STARTS_PER_IP_PER_HOUR=3
